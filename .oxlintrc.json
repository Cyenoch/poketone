{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ]
  },
  "ignorePatterns": [".agents/**", "skills-lock.json", "references/**", "dist/**"],
  "overrides": [
    {
      "files": ["src/run/sim/**", "src/run/lab.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          { "object": "Math", "property": "sin", "message": "Not deterministic; use sim/math.ts" },
          { "object": "Math", "property": "cos", "message": "Not deterministic; use sim/math.ts" },
          { "object": "Math", "property": "tan", "message": "Not deterministic; use sim/math.ts" },
          { "object": "Math", "property": "asin", "message": "Not deterministic; use sim/math.ts" },
          { "object": "Math", "property": "acos", "message": "Not deterministic; use sim/math.ts" },
          { "object": "Math", "property": "atan", "message": "Not deterministic; use sim/math.ts" },
          {
            "object": "Math",
            "property": "atan2",
            "message": "Not deterministic; use sim/math.ts"
          },
          { "object": "Math", "property": "sinh", "message": "Not deterministic; use sim/math.ts" },
          { "object": "Math", "property": "cosh", "message": "Not deterministic; use sim/math.ts" },
          { "object": "Math", "property": "tanh", "message": "Not deterministic; use sim/math.ts" },
          {
            "object": "Math",
            "property": "asinh",
            "message": "Not deterministic; use sim/math.ts"
          },
          {
            "object": "Math",
            "property": "acosh",
            "message": "Not deterministic; use sim/math.ts"
          },
          {
            "object": "Math",
            "property": "atanh",
            "message": "Not deterministic; use sim/math.ts"
          },
          { "object": "Math", "property": "exp", "message": "Not deterministic; use sim/math.ts" },
          {
            "object": "Math",
            "property": "expm1",
            "message": "Not deterministic; use sim/math.ts"
          },
          { "object": "Math", "property": "log", "message": "Not deterministic; use sim/math.ts" },
          {
            "object": "Math",
            "property": "log1p",
            "message": "Not deterministic; use sim/math.ts"
          },
          { "object": "Math", "property": "log2", "message": "Not deterministic; use sim/math.ts" },
          {
            "object": "Math",
            "property": "log10",
            "message": "Not deterministic; use sim/math.ts"
          },
          { "object": "Math", "property": "pow", "message": "Not deterministic; use sim/math.ts" },
          {
            "object": "Math",
            "property": "hypot",
            "message": "Not deterministic; use sim/math.ts"
          },
          { "object": "Math", "property": "cbrt", "message": "Not deterministic; use sim/math.ts" }
        ]
      }
    },
    {
      "files": ["scripts/**/*.test.mjs"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    }
  ]
}
