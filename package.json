{
  "name": "poketone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "spec": "openspec",
    "spec:list": "openspec list",
    "spec:specs": "openspec list --specs",
    "spec:check": "openspec validate --all --strict --no-interactive && openspec validate --archived --strict --no-interactive",
    "prepare": "bun scripts/install-hooks.mjs",
    "dev": "bun scripts/dev.mjs",
    "assets:game": "blender --background --factory-startup --python-exit-code 1 --python assets/prepare-game-models.py --",
    "build": "bun run typecheck && bun scripts/web-build.mjs",
    "preview": "bun scripts/web.mjs",
    "lint": "oxlint --max-warnings 0 .",
    "lint:fix": "oxlint --fix --max-warnings 0 .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b",
    "test:sim": "bun scripts/test-deadline.mjs 300 bun test --parallel --timeout=0 ./scripts/campaign.test.mjs ./scripts/enemy-ai.test.mjs ./scripts/nav.test.mjs ./scripts/mapgen.test.mjs ./scripts/combat.test.mjs ./scripts/coop.test.mjs ./scripts/view.test.mjs ./scripts/archetypes.test.mjs ./scripts/model.test.mjs ./scripts/model-survival.test.mjs ./scripts/lab.test.mjs ./scripts/stats.test.mjs ./scripts/triggers.test.mjs ./scripts/items.test.mjs ./scripts/triggered-items.test.mjs ./scripts/survival-items.test.mjs ./scripts/evolution.test.mjs ./scripts/stations.test.mjs ./scripts/partners.test.mjs ./scripts/camera.test.mjs ./scripts/audio.test.mjs ./scripts/sim-math.test.mjs ./scripts/snapshot.test.mjs ./scripts/zones.test.mjs ./scripts/zone-skills.test.mjs ./scripts/late-zones.test.mjs ./scripts/ultimate-fire-vfx.test.mjs",
    "test:ui": "bun scripts/test-deadline.mjs 300 bun test --parallel --timeout=0 ./scripts/ui-*.test.mjs",
    "balance": "bun scripts/balance-bot.ts",
    "balance:model": "bun scripts/balance-model.ts",
    "check": "bun run format:check && bun run lint && bun run build",
    "golden": "bun scripts/golden.mjs",
    "audio:master": "bun scripts/audio-master.mjs",
    "check:centering": "bun scripts/ui-centering.mjs",
    "fonts:core": "uv run -q --with fonttools==4.68.0 --with brotli==1.2.1 --with pillow==13.0.0 python scripts/fonts/build-core.py",
    "fonts:base": "uv run -q --with fonttools==4.68.0 --with brotli==1.2.1 --with pillow==13.0.0 python scripts/fonts/build-base.py",
    "qa:visual": "bun scripts/qa/visual.mjs",
    "harbor": "bun services/harbor/server.ts",
    "test:network": "bun test --timeout=15000 ./scripts/network*.test.mjs",
    "native": "bun scripts/native.mjs",
    "build:native": "bun scripts/native-build.mjs",
    "test:native": "bun test scripts/native-platform.test.mjs scripts/native-text.test.mjs scripts/native-save.test.mjs scripts/native-ui-input.test.mjs scripts/three-external-context.test.mjs && bun scripts/native-check.mjs",
    "test:build": "bun test --timeout=15000 scripts/build.test.mjs scripts/web.test.mjs"
  },
  "dependencies": {
    "@pmndrs/uikit": "1.0.78",
    "@stylexjs/stylex": "0.19.1",
    "@tweenjs/tween.js": "25.0.0",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "acorn": "8.19.0",
    "meshoptimizer": "1.3.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "@kmamal/sdl": "0.11.13",
    "node-datachannel": "0.33.6",
    "node-web-audio-api": "2.2.0",
    "sharp": "0.34.5",
    "webgl-node": "1.6.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@kmamal/sdl@0.11.13": "patches/@kmamal__sdl@0.11.13.patch",
    "@types/three@0.186.0": "patches/@types__three@0.186.0.patch",
    "@pmndrs/uikit@1.0.78": "patches/@pmndrs__uikit@1.0.78.patch",
    "webgl-node@1.6.2": "patches/webgl-node@1.6.2.patch",
    "three@0.186.1": "patches/three@0.186.1.patch"
  },
  "trustedDependencies": [
    "@kmamal/sdl",
    "native-gles"
  ]
}
